--
-- V2X Capture Metadata Profile
-- Observer location, motion, provenance, and radio observations.
--
-- An observer is the receiver, transmitter, sniffer, replay source,
-- or capture agent. These values describe that observer, not a remote
-- V2X participant. EPB time is defined by the associated IDB profile
-- option; no duplicate timestamp is encoded in this module.
--
V2X-Capture-Observer
{ iso(1) identified-organization(3) v2xCapture(99999)
  observer(4) version1(1) }
DEFINITIONS AUTOMATIC TAGS ::= BEGIN
IMPORTS
    ReceiverId, InterfaceId, Availability, MeasurementValue,
    DurationUs
FROM V2X-Capture-Common;
-- Identifies the coordinate reference system (CRS) used for all
-- position components in the containing GeodeticLocation.
-- A CRS is broader than a geodetic datum: it can describe a mandated
-- transform or protected coordinate representation as well.
CoordinateReferenceSystemKind ::= ENUMERATED {
    -- Direct World Geodetic System 1984 coordinates.
    wgs84(0),
    -- China GCJ-02 transformed geographic coordinates.
    gcj02(1),
    -- Another named CRS, datum, transformed, or protected system.
    other(254),
    -- The producer cannot identify the coordinate system.
    unknown(255)
}
-- For other, systemId identifies the governing specification or
-- registry. A reader shall never assume that
-- values are WGS-84 or safely convertible merely because they are
-- carried as latitude and longitude.
CoordinateReferenceSystem ::= SEQUENCE {
    -- CRS, datum, transform, or protected-system category.
    kind                   CoordinateReferenceSystemKind,
    -- Required when kind is other; UTF-8 identifier of the system.
    -- Examples include a registry identifier or specification name.
    systemId               UTF8String (SIZE(1..128)) OPTIONAL,
    ...
}
-- Latitude, longitude, and altitude use the same declared coordinate
-- reference system. For WGS-84, altitude is ellipsoidal height. For
-- another CRS, the system identified by systemId defines the
-- vertical interpretation. A producer shall not silently mix systems.
GeodeticLocation ::= SEQUENCE {
    -- Coordinate system for latitude, longitude, and altitude.
    coordinateReferenceSystem
                           CoordinateReferenceSystem,
    -- Latitude in degrees multiplied by 10^7 in the stated system.
    latitudeE7             INTEGER (-900000000..900000000),
    -- Longitude in degrees multiplied by 10^7 in the stated system.
    longitudeE7            INTEGER (-1800000000..1800000000),
    -- Height in centimeters in the stated system, if known.
    altitudeCm             INTEGER (-10000000..100000000) OPTIONAL,
    ...
}
-- Observer motion at or near the EPB capture time.
-- Heading is always clockwise degrees from true north.
ObserverMotion ::= SEQUENCE {
    -- Observer ground speed in centimeters per second.
    speedCmPerSec          MeasurementValue OPTIONAL,
    -- Heading in degrees times 100, constrained to [0, 36000).
    headingDegX100         MeasurementValue OPTIONAL,
    ...
}
-- Position quality and motion for the capture observer.
ObserverLocation ::= SEQUENCE {
    -- Geodetic position of the capture observer.
    position               GeodeticLocation,
    -- Horizontal estimated position error in centimeters.
    hepeCm                 INTEGER (0..4294967295) OPTIONAL,
    -- Age of position/motion source data at EPB capture time.
    ageUs                  DurationUs OPTIONAL,
    -- Positioning source or method, for example GNSS.
    source                 OCTET STRING (SIZE(1..32)) OPTIONAL,
    -- Optional observer speed and true-north heading.
    motion                 ObserverMotion OPTIONAL,
    ...
}
-- How packet bytes or observations entered the capture system.
CaptureSource ::= ENUMERATED {
    -- Antenna or RF observation of an over-the-air packet.
    overTheAir(0),
    -- Packet or metadata came from a modem diagnostic/export path.
    modemExport(1),
    -- Packet or metadata came from an OS or driver export path.
    driverExport(2),
    -- Packet was replayed from stored capture or test data.
    replay(3),
    -- Packet was injected for test, simulation, or radio operation.
    injected(4),
    -- Observation was synthesized after original capture.
    derived(5),
    -- Capture origin cannot be identified.
    unknown(255)
}
-- Identifies the capture path and implementation when known.
ObserverProvenance ::= SEQUENCE {
    -- Receiver, transmitter, or sniffer identity.
    receiverId             ReceiverId OPTIONAL,
    -- Producer's capture-interface identity.
    interfaceId            InterfaceId OPTIONAL,
    -- Ingress path for bytes or metadata.
    captureSource          CaptureSource OPTIONAL,
    -- Platform or product identity.
    platformId             OCTET STRING (SIZE(1..64)) OPTIONAL,
    -- Hardware revision or identifying version.
    hardwareVersion        OCTET STRING (SIZE(1..64)) OPTIONAL,
    -- Software/firmware revision relevant to capture behavior.
    softwareVersion        OCTET STRING (SIZE(1..64)) OPTIONAL,
    -- Driver or modem version, if separately known.
    driverOrModemVersion   OCTET STRING (SIZE(1..64)) OPTIONAL,
    -- Capture-agent name/version.
    captureAgent           OCTET STRING (SIZE(1..64)) OPTIONAL,
    -- Identifier for the antenna mapping used by the producer.
    antennaMapId           OCTET STRING (SIZE(1..64)) OPTIONAL,
    ...
}
-- Receive-side per-antenna radio measurements.
AntennaRssi ::= SEQUENCE {
    -- Producer's zero-based antenna index.
    antennaIndex           INTEGER (0..255),
    -- RSSI in dBm times 10.
    rssiDbmX10             MeasurementValue,
    -- RSRP in dBm times 10, when applicable.
    rsrpDbmX10             MeasurementValue OPTIONAL,
    -- RSRQ in dB times 10, when applicable.
    rsrqDbX10              MeasurementValue OPTIONAL,
    -- SINR in dB times 10, when applicable.
    sinrDbX10              MeasurementValue OPTIONAL,
    ...
}
-- Name and interpretation of a channel-utilization measurement.
ChannelLoadKind ::= ENUMERATED {
    -- Busy fraction or samples expressed as a ratio.
    channelBusyRatio(0),
    -- Probability that the channel is busy under stated method.
    channelBusyProbability(1),
    -- Generic channel-load metric with source-defined calculation.
    channelLoad(2),
    -- Another documented metric.
    other(254),
    -- Producer cannot identify the metric.
    unknown(255)
}
-- Channel load is only meaningful with its measurement window/method.
ChannelLoad ::= SEQUENCE {
    -- Metric represented by valuePercentX100.
    kind                   ChannelLoadKind,
    -- Value in 0.01 percent units.
    valuePercentX100       MeasurementValue,
    -- Interval over which the value was measured.
    measurementWindowUs    DurationUs OPTIONAL,
    -- Source or method that produced the metric.
    source                 OCTET STRING (SIZE(1..32)) OPTIONAL,
    ...
}
-- Receive-side RF observations at or near the EPB capture time.
ReceiveRadioObservation ::= SEQUENCE {
    -- RSSI and optional related values for each exposed antenna.
    antennaRssi            SEQUENCE (SIZE(0..MAX)) OF AntennaRssi
                            OPTIONAL,
    -- Estimated propagation delay in nanoseconds.
    propagationDelayNs     MeasurementValue OPTIONAL,
    -- Channel busy/load context when measured.
    channelLoad            ChannelLoad OPTIONAL,
    -- Tuned or observed center frequency in kHz.
    centerFrequencyKHz     MeasurementValue OPTIONAL,
    -- Observed channel bandwidth in kHz.
    bandwidthKHz           MeasurementValue OPTIONAL,
    ...
}
-- Transmit-side RF settings or measurements near the EPB time.
TransmitRadioObservation ::= SEQUENCE {
    -- Selected transmit antenna index, when exposed.
    antennaIndex           MeasurementValue OPTIONAL,
    -- Producer-reported transmit power in dBm times 10.
    transmitPowerDbmX10    MeasurementValue OPTIONAL,
    -- Channel busy/load context when measured.
    channelLoad            ChannelLoad OPTIONAL,
    -- Tuned transmit center frequency in kHz.
    centerFrequencyKHz     MeasurementValue OPTIONAL,
    -- Transmit channel bandwidth in kHz.
    bandwidthKHz           MeasurementValue OPTIONAL,
    ...
}
-- Receive-side context for a logical packet.
ReceiveObservation ::= SEQUENCE {
    -- Observer position/motion near the EPB capture timestamp.
    location               ObserverLocation OPTIONAL,
    -- Receive-side radio observations near EPB capture timestamp.
    radio                  ReceiveRadioObservation OPTIONAL,
    -- Capture source and implementation identity.
    provenance             ObserverProvenance OPTIONAL,
    ...
}
-- Transmit-side context for a logical packet.
TransmitObservation ::= SEQUENCE {
    -- Observer position/motion near the EPB capture timestamp.
    location               ObserverLocation OPTIONAL,
    -- Transmit-side radio settings or measurements.
    radio                  TransmitRadioObservation OPTIONAL,
    -- Capture source and implementation identity.
    provenance             ObserverProvenance OPTIONAL,
    ...
}
END
