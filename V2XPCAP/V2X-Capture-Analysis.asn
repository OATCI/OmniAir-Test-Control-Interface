--
-- V2X Capture Metadata Profile
-- Per-EPB local analysis annotations.
--
-- These results are generated by an ITS stack, capture producer, or
-- post-capture analyzer. They are not on-air bytes and are not signed
-- packet data. A missing category means that it was not available or
-- was not performed; it does not imply a pass.
--
V2X-Capture-Analysis
{ iso(1) identified-organization(3) v2xCapture(99999)
  analysis(10) version1(1) }
DEFINITIONS AUTOMATIC TAGS ::= BEGIN
IMPORTS
    DurationUs
FROM V2X-Capture-Common;
-- Outcome of one local processing category.
ProcessingResult ::= ENUMERATED {
    -- Check was deliberately not requested or started.
    notAttempted(0),
    -- Check completed without a detected failure in this category.
    passed(1),
    -- Check completed and detected one or more failures.
    failed(2),
    -- Check ran, but evidence did not support pass or fail.
    inconclusive(3),
    -- Needed input, capability, or supporting data was unavailable.
    unavailable(4),
    -- Check has no meaning for this packet or context.
    notApplicable(5),
    -- Producer cannot state the processing result.
    unknown(255)
}
-- attempted and processed preserve the distinction between no work,
-- incomplete work, and a completed result.
ProcessingStatus ::= SEQUENCE {
    -- True when evaluation was requested or started.
    attempted              BOOLEAN DEFAULT FALSE,
    -- True when evaluation reached a reportable result.
    processed              BOOLEAN DEFAULT FALSE,
    -- Explicit outcome of this processing category.
    result                 ProcessingResult,
    ...
}
-- Where the local annotations were generated.
AnalysisOrigin ::= ENUMERATED {
    -- Produced by the observer's ITS protocol, security, or
    -- application stack.
    itsStack(0),
    -- Produced by the capture agent, driver, modem, or recorder.
    captureSystem(1),
    -- Produced after capture by a separate analysis process.
    postCaptureAnalyzer(2),
    -- Produced by another documented source.
    other(254),
    -- Producer cannot identify the source.
    unknown(255)
}
-- A set bit means the stated cryptographic or credential-validation
-- condition was observed. Relevance and consistency are reported by
-- their own annotations rather than being folded into this bitmap.
SecurityFailureBitmap ::= BIT STRING {
    -- Secured packet or SPDU structure could not be parsed.
    parseFailure(0),
    -- A required critical information element was unsupported.
    unsupportedCriticalInfo(1),
    -- Signer certificate or signer identifier was not located.
    signerNotFound(2),
    -- Signer certificate validity interval had expired.
    certificateExpired(3),
    -- Signer certificate was not yet valid at checked time.
    certificateNotYetValid(4),
    -- Certificate was determined to be revoked.
    certificateRevoked(5),
    -- Certificate chain could not be built or validated.
    chainBuildFailure(6),
    -- Chain terminates at a root not trusted by this analyzer.
    untrustedRoot(7),
    -- Chain exceeded policy or implementation length limits.
    chainTooLong(8),
    -- Required revocation information was unavailable or overdue.
    revocationInfoUnavailable(9),
    -- Signature or other cryptographic verification failed.
    signatureInvalid(10),
    -- PSID, SSP, or certificate permission was unauthorized.
    unauthorizedPsidOrSsp(11),
    -- Signed external-data hash did not match supplied data.
    externalHashMismatch(12)
} (SIZE(0..256))
-- A set bit means a receiver-context relevance rule did not hold.
RelevanceFailureBitmap ::= BIT STRING {
    -- Generation time was stale, too far in the future, or otherwise
    -- outside the receiver's relevance policy.
    generationTimeInvalid(0),
    -- Expiration time made the packet irrelevant at the observer.
    expirationTimeInvalid(1),
    -- Generation location was outside the relevant range or context.
    generationLocationInvalid(2),
    -- Packet was identified as duplicate or replayed.
    duplicateOrReplay(3),
    -- Message or certificate validity region did not apply here.
    validityRegionInvalid(4)
} (SIZE(0..256))
-- A set bit means fields that should agree did not agree.
ConsistencyFailureBitmap ::= BIT STRING {
    -- Header PSID and protected or application PSID disagree.
    headerPsidMismatch(0),
    -- Certificate fields or permissions are internally inconsistent.
    certificateConsistencyFailure(1),
    -- Signed-data fields are internally inconsistent.
    signedDataConsistencyFailure(2),
    -- Application data conflicts with its declared profile or
    -- context.
    applicationProfileMismatch(3)
} (SIZE(0..256))
-- Cryptographic and credential-processing result. It does not report
-- receiver relevance or internal consistency checks.
SecurityValidationAnnotation ::= SEQUENCE {
    -- Processing state and final result.
    status                 ProcessingStatus,
    -- Compact validation failures when result is failed.
    failures               SecurityFailureBitmap OPTIONAL,
    ...
}
-- Receiver-context applicability result, such as freshness, replay,
-- geography, and validity-region applicability.
RelevanceAnnotation ::= SEQUENCE {
    -- Processing state and final result.
    status                 ProcessingStatus,
    -- Compact relevance failures when result is failed.
    failures               RelevanceFailureBitmap OPTIONAL,
    ...
}
-- Agreement among SPDU, certificate, application, and profile fields.
ConsistencyAnnotation ::= SEQUENCE {
    -- Processing state and final result.
    status                 ProcessingStatus,
    -- Compact consistency failures when result is failed.
    failures               ConsistencyFailureBitmap OPTIONAL,
    ...
}
-- Misbehavior Detection (MBD) is distinct from security validation.
-- It is intentionally message- and market-neutral: it may describe
-- BSM, CAM, DENM, CPM, CMM, VAM, or another message/profile family.
-- The core requires no detector ID, regional profile ID, or evidence
-- dictionary. Such details can be placed in a separate owner option.
MisbehaviorDetectionAnnotation ::= SEQUENCE {
    -- Processing state and final result.
    status                 ProcessingStatus,
    ...
}
-- Count of distinct remote vehicles in a stated observation window.
UniqueRemoteVehicleObservation ::= SEQUENCE {
    -- Number of distinct remote vehicles observed in the window.
    count                  INTEGER (0..65535),
    -- Look-back interval used to count the distinct vehicles.
    observationWindowUs    DurationUs,
    ...
}
-- Tx-side application congestion-control values for this packet.
-- They are provided by the observer's ITS application or stack, not
-- by the PHY. They are not an LTE/NR PHY CQI report.
ApplicationCongestionAnnotation ::= SEQUENCE {
    -- J3161/1 Channel Quality Indicator, scaled by 10^4.
    -- For example, 3000 represents an indicator of 0.3000.
    j3161ChannelQualityIndicatorX10000
                           INTEGER (0..10000) OPTIONAL,
    -- J3161/1 vehicle density in range: unique remote vehicles whose
    -- relevant 2D positions are within the defined range.
    j3161VehicleDensityInRange
                           INTEGER (0..65535) OPTIONAL,
    -- Optional radius used for the density value, in meters.
    densityRangeM          INTEGER (0..65535) OPTIONAL,
    -- All distinct remote vehicles seen over a declared look-back
    -- window. This may use a scope broader than densityRangeM.
    uniqueRemoteVehicles   UniqueRemoteVehicleObservation OPTIONAL,
    ...
}
-- Application-side annotations associated with transmission.
TransmitApplicationAnnotation ::= SEQUENCE {
    -- Optional congestion-control values used for this transmission.
    congestion             ApplicationCongestionAnnotation OPTIONAL,
    ...
}
-- Application-side annotations associated with reception.
-- No receive-side measurement dictionary is mandated by this version.
ReceiveApplicationAnnotation ::= SEQUENCE {
    -- Processing state for any receiver application annotation.
    status                 ProcessingStatus OPTIONAL,
    ...
}
-- Separates application/stack annotations by packet direction.
ApplicationAnnotation ::= SEQUENCE {
    -- Values relevant to the local transmit path.
    transmit               TransmitApplicationAnnotation OPTIONAL,
    -- Values relevant to the local receive path.
    receive                ReceiveApplicationAnnotation OPTIONAL,
    ...
}
-- Independent categories may be absent when the producer did not run
-- them. All values are local annotations, never transmitted content.
AnalysisAnnotations ::= SEQUENCE {
    -- Origin of the local annotations in this object.
    origin                 AnalysisOrigin OPTIONAL,
    -- Cryptographic and credential-validation outcome.
    securityValidation     SecurityValidationAnnotation OPTIONAL,
    -- Receiver-context applicability outcome.
    relevance              RelevanceAnnotation OPTIONAL,
    -- Internal field and profile agreement outcome.
    consistency            ConsistencyAnnotation OPTIONAL,
    -- Message/profile-neutral Misbehavior Detection outcome.
    misbehaviorDetection   MisbehaviorDetectionAnnotation OPTIONAL,
    -- Optional local ITS application or stack annotations.
    application            ApplicationAnnotation OPTIONAL,
    ...
}
END
