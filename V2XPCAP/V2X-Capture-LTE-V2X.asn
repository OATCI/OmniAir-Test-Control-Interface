--
-- V2X Capture Metadata Profile
-- LTE-V2X summary for one logical V2X packet.
--
-- IEEE 1609.3 LTE-V2X processing includes MAC, RLC, and PDCP, but
-- this
-- profile does not reproduce their raw bytes. It carries compact
-- observations that a modem or driver is likely to expose.
--
V2X-Capture-LTE-V2X
{ iso(1) identified-organization(3) v2xCapture(99999)
  lteV2x(7) version1(1) }
DEFINITIONS AUTOMATIC TAGS ::= BEGIN

IMPORTS
    Availability, MeasurementValue, StatusBoolean
FROM V2X-Capture-Common;

-- LTE PC5 Layer-2 identifiers and PPPP are LTE-specific. They are not
-- common payload fields. Source L2 ID is 24 bits; destination ID may
-- be 16 or 24 bits according to the applicable LTE V2X context.
LtePc5Addressing ::= SEQUENCE {
    -- Source PC5 Layer-2 identifier when exposed by LTE sidelink.
    sourceLayer2Id         OCTET STRING (SIZE(3)) OPTIONAL,
    -- Destination PC5 Layer-2 identifier in applicable LTE form.
    destinationLayer2Id    OCTET STRING (SIZE(2..3)) OPTIONAL,
    -- LTE PC5 PPPP service-priority value, not an SCI priority.
    pppp                   INTEGER (1..8) OPTIONAL,
    ...
}

-- SCI1 is LTE sidelink control on PSCCH. Values are capture-side
-- observations, not a reconstructed SCI bit field.
LteSci1Observation ::= SEQUENCE {
    -- Whether SCI1 was exposed and decoded.
    availability            Availability,
    -- SCI priority codepoint; separate from PC5 PPPP.
    priority                MeasurementValue OPTIONAL,
    -- SCI resource-reservation codepoint.
    resourceReservation     MeasurementValue OPTIONAL,
    -- SCI frequency-resource allocation codepoint.
    frequencyResource       MeasurementValue OPTIONAL,
    -- SCI time-resource or time-gap codepoint.
    timeGap                 MeasurementValue OPTIONAL,
    -- SCI modulation and coding scheme codepoint.
    mcs                     MeasurementValue OPTIONAL,
    -- SCI retransmission-index codepoint.
    retransmissionIndex     MeasurementValue OPTIONAL,
    -- SCI transmission-format codepoint, if exposed.
    transmissionFormat      MeasurementValue OPTIONAL,
    ...
}

-- Logical-packet summary only. Raw RLC/PDCP bytes, per-segment rows,
-- per-transport-block rows, and HARQ-event lists are outside the
-- core.
LteLowerLayerSummary ::= SEQUENCE {
    -- Whether HARQ was used for this logical packet.
    harqUsed                StatusBoolean OPTIONAL,
    -- Known HARQ transmissions, if the source supplies a count.
    harqTransmissionCount   MeasurementValue OPTIONAL,
    -- Known RLC segments summarized by this logical packet.
    rlcSegmentCount          MeasurementValue OPTIONAL,
    -- Reported RLC errors associated with this logical packet.
    rlcErrorCount            MeasurementValue OPTIONAL,
    -- Reported PDCP errors associated with this logical packet.
    pdcpErrorCount           MeasurementValue OPTIONAL,
    ...
}

-- LTE-specific metadata for this logical packet.
LteV2xMetadata ::= SEQUENCE {
    -- LTE PC5 addressing and PPPP, when exposed.
    pc5Addressing            LtePc5Addressing OPTIONAL,
    -- LTE PSCCH SCI1 observation summary.
    pscch                    LteSci1Observation OPTIONAL,
    -- Compact MAC/RLC/PDCP/HARQ outcome summary.
    lowerLayerSummary        LteLowerLayerSummary OPTIONAL,
    ...
}

END
